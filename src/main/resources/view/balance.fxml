<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="420.0" style="-fx-background-color: white; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.BalanceController">
   <children>
      <!-- Title -->
      <Label layoutX="25.0" layoutY="20.0" text="Payment / Balance" textFill="#1e293b">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Separator layoutX="25.0" layoutY="54.0" prefWidth="370.0" />

      <!-- Order Items -->
      <Label layoutX="25.0" layoutY="63.0" text="Order Items" textFill="#64748b" />
      <TextArea fx:id="txtDescription" editable="false" layoutX="25.0" layoutY="82.0" prefHeight="100.0" prefWidth="370.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 10;" wrapText="true" />

      <!-- Billing Card -->
      <AnchorPane layoutX="25.0" layoutY="195.0" prefHeight="300.0" prefWidth="370.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
         <children>
            <!-- Customer -->
            <Label layoutX="15.0" layoutY="12.0" text="Customer" textFill="#64748b" />
            <Label fx:id="lblCustomer" layoutX="15.0" layoutY="30.0" text="-" textFill="#1e293b">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>

            <!-- Existing Due -->
            <Label layoutX="200.0" layoutY="12.0" text="Existing Due" textFill="#64748b" />
            <Label fx:id="lblExistingDue" layoutX="200.0" layoutY="30.0" text="Rs. 0.00" textFill="#ef4444" visible="false">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <CheckBox fx:id="chkPayDue" layoutX="200.0" layoutY="50.0" managed="false" text="Pay Due" visible="false" />

            <Separator layoutX="15.0" layoutY="63.0" prefWidth="340.0" />

            <!-- Bill Total -->
            <Label layoutX="199.0" layoutY="80.0" text="Bill Total" textFill="#64748b" />
            <Label fx:id="lblNetTotal" layoutX="259.0" layoutY="78.0" prefHeight="22.0" prefWidth="98.0" text="0.00" textFill="#dc2626">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <Pane layoutX="10.0" layoutY="74.0" prefHeight="78.0" prefWidth="162.0" style="-fx-background-radius: 10; -fx-background-color: #dedede; -fx-opacity: .5;" />

            <!-- Tax -->
            <Label layoutX="23.0" layoutY="88.0" text="Tax (%)" textFill="#64748b" />
            <TextField fx:id="txtTaxRate" layoutX="73.0" layoutY="83.0" onKeyReleased="#onTaxRateChanged" prefHeight="27.0" prefWidth="86.0" promptText="0" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            <Label layoutX="198.0" layoutY="105.0" text="percent" textFill="#64748b" />
            <Label fx:id="lblTaxAmount" layoutX="260.0" layoutY="105.0" prefHeight="20.0" prefWidth="98.0" text="0.00" textFill="#1e293b">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>

            <!-- Total with Tax -->
            <Label layoutX="198.0" layoutY="133.0" text="Net Total" textFill="#64748b" />
            <Label fx:id="lblTotalWithTax" layoutX="258.0" layoutY="129.0" prefHeight="26.0" prefWidth="98.0" text="0.00" textFill="#dc2626">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>

            <Separator layoutX="15.0" layoutY="165.0" prefWidth="340.0" />

            <!-- Amount Paid -->
            <Label layoutX="15.0" layoutY="182.0" text="Amount Received (Rs.)" textFill="#64748b" />
            <TextField fx:id="txtAmountPaid" layoutX="160.0" layoutY="178.0" onAction="#onAmountPaidAction" onKeyReleased="#onAmountPaidChanged" prefHeight="28.0" prefWidth="190.0" promptText="0.00" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />

            <!-- Payment Method -->
            <Label layoutX="15.0" layoutY="218.0" text="Payment Method" textFill="#64748b" />
            <ComboBox fx:id="cmbPaymentMethod" layoutX="130.0" layoutY="214.0" onAction="#onPaymentMethodAction" prefHeight="28.0" prefWidth="224.0" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />

            <!-- Balance -->
            <Label layoutX="15.0" layoutY="258.0" text="Balance" textFill="#64748b" />
            <Label fx:id="lblBalance" layoutX="130.0" layoutY="249.0" prefHeight="35.0" prefWidth="119.0" text="0.00" textFill="#16a34a">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Button layoutX="21.0" layoutY="117.0" mnemonicParsing="false" prefHeight="18.0" prefWidth="140.0" style="-fx-background-color: #898989; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Update" textFill="#898989" />
         </children>
      </AnchorPane>

      <!-- Balance Note -->
      <Label fx:id="lblBalanceNote" layoutX="25.0" layoutY="505.0" prefWidth="370.0" text="" textFill="#ef4444" wrapText="true" />

      <!-- Buttons -->
      <Button layoutX="205.0" layoutY="505.0" mnemonicParsing="false" onAction="#btnConfirmOnAction" prefHeight="36.0" prefWidth="190.0" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Complete Sale" />
      <Button layoutX="25.0" layoutY="505.0" mnemonicParsing="false" onAction="#btnCancelOnAction" prefHeight="36.0" prefWidth="170.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Cancel" />
   </children>
</AnchorPane>
