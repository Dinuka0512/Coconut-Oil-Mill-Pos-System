<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="226.0" prefWidth="329.0" style="-fx-background-color: white;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.AddPriceStockController">
   <children>
      <Label fx:id="lblTitle" layoutX="33.0" layoutY="23.0" text="Add New Price &amp; Stock" textFill="#1e293b">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>

      <Label layoutX="34.0" layoutY="60.0" text="Product" textFill="#64748b" />
      <Label fx:id="lblProduct" layoutX="110.0" layoutY="57.0" prefHeight="19.0" prefWidth="194.0" text="-" textFill="#1e293b">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>

      <Label layoutX="34.0" layoutY="90.0" text="Price (LKR)" textFill="#64748b" />
      <TextField fx:id="txtPrice" layoutX="110.0" layoutY="83.0" onAction="#txtPriceOnAction" prefHeight="30.0" prefWidth="194.0" promptText="0.00" style="-fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />

      <Label layoutX="34.0" layoutY="133.0" text="Stock (Kg)" textFill="#64748b" />
      <TextField fx:id="txtStock" layoutX="110.0" layoutY="126.0" onAction="#txtStockOnAction" prefHeight="30.0" prefWidth="194.0" promptText="0" style="-fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />

      <Button fx:id="btnSave" layoutX="29.0" layoutY="172.0" mnemonicParsing="false" onAction="#btnSaveOnAction" prefHeight="32.0" prefWidth="150.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Add Price" />
      <Button fx:id="btnCancel" layoutX="190.0" layoutY="173.0" mnemonicParsing="false" onAction="#btnCancelOnAction" prefHeight="32.0" prefWidth="109.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Cancel" />
   </children>
</AnchorPane>
