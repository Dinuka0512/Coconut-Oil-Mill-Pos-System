<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="body" prefHeight="517.0" prefWidth="796.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.SettingsController">

    <children>

        <!-- Card Background -->
        <AnchorPane layoutX="53.0" layoutY="39.0" prefHeight="440.0" prefWidth="440.0" style="-fx-background-color: white;                            -fx-background-radius: 20;                            -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15,0,0,5);">

            <children>

                <!-- Title -->
                <Label layoutX="157.0" layoutY="28.0" style="-fx-text-fill: #333;" text="Edit Profile" textFill="#949494">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <!-- Name -->
                <Label layoutX="60.0" layoutY="71.0" text="Name" />
                <TextField fx:id="txtName" layoutX="60.0" layoutY="91.0" prefHeight="38.0" prefWidth="320.0" promptText="Enter your name" style="-fx-background-color: #f9fafc;                                   -fx-border-color: #dcdfe6;                                   -fx-border-radius: 12;                                   -fx-background-radius: 12;                                   -fx-padding: 10;" />

                <!-- Email -->
                <Label layoutX="60.0" layoutY="141.0" text="Email" />
                <TextField fx:id="txtEmail" layoutX="60.0" layoutY="161.0" prefHeight="38.0" prefWidth="320.0" promptText="Enter your email" style="-fx-background-color: #f9fafc;                                   -fx-border-color: #dcdfe6;                                   -fx-border-radius: 12;                                   -fx-background-radius: 12;                                   -fx-padding: 10;" />

                <!-- Current Password -->
                <Label layoutX="60.0" layoutY="211.0" text="Current Password" />
                <PasswordField fx:id="txtCPassword" layoutX="60.0" layoutY="231.0" prefHeight="38.0" prefWidth="320.0" promptText="Current password" style="-fx-background-color: #f9fafc;                                       -fx-border-color: #dcdfe6;                                       -fx-border-radius: 12;                                       -fx-background-radius: 12;                                       -fx-padding: 10;" />

                <!-- New Password -->
                <Label layoutX="60.0" layoutY="281.0" text="New Password" />
                <PasswordField fx:id="txtNewPassword" layoutX="60.0" layoutY="301.0" prefHeight="38.0" prefWidth="320.0" promptText="New password" style="-fx-background-color: #f9fafc;                                       -fx-border-color: #dcdfe6;                                       -fx-border-radius: 12;                                       -fx-background-radius: 12;                                       -fx-padding: 10;" />

                <!-- Update Button -->
                <Button layoutX="60.0" layoutY="361.0" onAction="#updateUser" prefHeight="42.0" prefWidth="320.0" style="-fx-background-color: linear-gradient(to right, #ffb347, #ffcc33);                                -fx-background-radius: 25;                                -fx-text-fill: white;                                -fx-font-weight: bold;" text="Update Profile" />

            </children>
        </AnchorPane>

    </children>
</AnchorPane>
