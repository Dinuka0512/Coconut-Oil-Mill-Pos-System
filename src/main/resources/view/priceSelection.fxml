<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="400.0" style="-fx-background-color: white; -fx-background-radius: 12;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.PriceSelectionController">
   <children>
      <!-- Title -->
      <Label layoutX="25.0" layoutY="20.0" text="Select Unit Price" textFill="#0f172a">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Separator layoutX="25.0" layoutY="54.0" prefHeight="3.0" prefWidth="350.0" />

      <!-- Product Info Card -->
      <AnchorPane layoutX="25.0" layoutY="68.0" prefHeight="58.0" prefWidth="350.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
         <children>
            <Label layoutX="15.0" layoutY="9.0" text="Product" textFill="#64748b" />
            <Label fx:id="lblProduct" layoutX="15.0" layoutY="27.0" prefHeight="19.0" prefWidth="320.0" text="-" textFill="#1e293b">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <!-- Price Selection -->
      <Label layoutX="25.0" layoutY="138.0" text="This product has multiple prices. Choose the price to use:" textFill="#7f8c8d" />
      <ComboBox fx:id="cmbPrice" layoutX="25.0" layoutY="162.0" prefHeight="36.0" prefWidth="350.0" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #bdc3c7;" />
      <Label layoutX="25.0" layoutY="206.0" text="↑ / ↓ move    ·    Enter select    ·    Esc cancel" textFill="#94a3b8">
         <font>
            <Font size="11.0" />
         </font>
      </Label>

      <!-- Buttons -->
      <Button fx:id="btnCancel" layoutX="165.0" layoutY="245.0" mnemonicParsing="false" onAction="#btnCancelOnAction" prefHeight="32.0" prefWidth="96.0" style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 5;" text="Cancel" />
      <Button fx:id="btnSelect" layoutX="271.0" layoutY="245.0" mnemonicParsing="false" onAction="#btnSelectOnAction" prefHeight="32.0" prefWidth="104.0" style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Select Price" />
   </children>
</AnchorPane>
