<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="517.0" prefWidth="796.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.OrderController">
   <children>
      <Label layoutX="32.0" layoutY="14.0" text="Point of Sale (POS)" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <Label layoutX="32.0" layoutY="55.0" text="Order ID:" textFill="#7f8c8d" />
      <Label fx:id="lblOrderId" layoutX="95.0" layoutY="55.0" text="O001" textFill="#27ae60">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      
      <Label layoutX="32.0" layoutY="75.0" text="Date:" textFill="#7f8c8d" />
      <Label fx:id="lblDate" layoutX="70.0" layoutY="75.0" text="2024-04-12" />
      
      <!-- Customer Section -->
      <AnchorPane layoutX="32.0" layoutY="105.0" prefHeight="70.0" prefWidth="350.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
         <children>
            <Label layoutX="15.0" layoutY="10.0" text="Select Customer (Name/Contact)" textFill="#7f8c8d" />
            <ComboBox fx:id="cmbCustomerId" layoutX="15.0" layoutY="30.0" onAction="#cmbCustomerOnAction" prefWidth="180.0" promptText="Type to Search..." editable="true" />
            <Button layoutX="205.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnNewCustomerOnAction" prefHeight="25.0" prefWidth="130.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ New Customer" />
          </children>
      </AnchorPane>
      
      <!-- Product Section -->
      <AnchorPane layoutX="395.0" layoutY="105.0" prefHeight="130.0" prefWidth="368.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
         <children>
            <Label layoutX="15.0" layoutY="10.0" text="Select Product (Name)" textFill="#7f8c8d" />
            <ComboBox fx:id="cmbProductId" layoutX="15.0" layoutY="30.0" onAction="#cmbProductOnAction" prefWidth="180.0" promptText="Type to Search..." editable="true" />
            
            <Button layoutX="205.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnNewProductOnAction" prefHeight="25.0" prefWidth="130.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ New Product" />
            
            <Label layoutX="15.0" layoutY="65.0" text="Unit Price" textFill="#7f8c8d" />
            <Label fx:id="lblUnitPrice" layoutX="15.0" layoutY="85.0" text="0.00" textFill="#e67e22">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            
            <Label layoutX="100.0" layoutY="65.0" text="Qty On Hand" textFill="#7f8c8d" />
            <Label fx:id="lblQtyOnHand" layoutX="100.0" layoutY="85.0" text="0" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            
            <Label layoutX="200.0" layoutY="65.0" text="Order Qty" textFill="#7f8c8d" />
            <TextField fx:id="txtQty" layoutX="200.0" layoutY="85.0" prefHeight="25.0" prefWidth="60.0" />
            
            <Button layoutX="273.0" layoutY="80.0" mnemonicParsing="false" onAction="#btnAddToCartOnAction" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Add" />
         </children>
      </AnchorPane>
      
      <TableView fx:id="tblOrderCart" layoutX="32.0" layoutY="250.0" prefHeight="200.0" prefWidth="732.0">
        <columns>
          <TableColumn fx:id="colDescription" prefWidth="330.0" text="Product Name" />
          <TableColumn fx:id="colQty" prefWidth="80.0" text="Qty" />
          <TableColumn fx:id="colUnitPrice" prefWidth="110.0" text="Unit Price" />
          <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total" />
          <TableColumn fx:id="colAction" prefWidth="90.0" text="Action" />
        </columns>
      </TableView>
      
      <Label layoutX="32.0" layoutY="465.0" text="NET TOTAL (LKR):" textFill="#c0392b">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label fx:id="lblNetTotal" layoutX="205.0" layoutY="465.0" text="0.00" textFill="#c0392b">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      
      <Button layoutX="634.0" layoutY="465.0" mnemonicParsing="false" onAction="#btnPlaceOrderOnAction" prefHeight="40.0" prefWidth="130.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 5;" text="PLACE ORDER" />
   </children>
</AnchorPane>
