        <!-- Username Field (styled) -->
        <TextField fx:id="txtUsername" layoutX="670.0" layoutY="262.0" onAction="#onUsernameAction" prefHeight="26.0" prefWidth="266.0" promptText="Username" style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 14px;" AnchorPane.rightAnchor="186.0" AnchorPane.topAnchor="262.0" />

