        <!-- Coconut Image -->
        <ImageView fitHeight="481.0" fitWidth="443.0" layoutY="198.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="198.0">
            <image>
                <Image url="@../asets/s.jpg" />
