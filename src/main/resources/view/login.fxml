            </font>
        </Label>

        <!-- Password Field (styled) -->
        <PasswordField fx:id="txtPassword" layoutX="670.0" layoutY="330.0" onAction="#onPasswordAction" prefHeight="26.0" prefWidth="266.0" promptText="Password" style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 14px;" AnchorPane.rightAnchor="186.0" AnchorPane.topAnchor="330.0" />

        <!-- Login Button -->
        <Button layoutX="670.0" layoutY="386.0" mnemonicParsing="false" onAction="#login" prefHeight="38.0" prefWidth="266.0" style="-fx-background-color: #ffc000; -fx-background-radius: 20;" text="LogIn" textFill="WHITE" AnchorPane.rightAnchor="186.0" AnchorPane.topAnchor="386.0">
