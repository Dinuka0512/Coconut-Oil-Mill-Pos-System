<AnchorPane fx:id="body" prefHeight="687.0" prefWidth="1122.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.LoginController">
