<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="body" prefHeight="517.0" prefWidth="796.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.UpdatePosController">
   <children>
      <Label layoutX="31.0" layoutY="26.0" text="Point of Sale (POS)" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <Label layoutX="30.0" layoutY="73.0" text="Order ID:" textFill="#7f8c8d" />
      <Label fx:id="lblOrderId" layoutX="93.0" layoutY="73.0" text="O001" textFill="#00a118">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      
      <Label layoutX="30.0" layoutY="93.0" text="Date:" textFill="#7f8c8d" />
      <Label fx:id="lblDate" layoutX="68.0" layoutY="93.0" text="2024-04-12" />
      
      <!-- Customer Section -->
      <AnchorPane layoutX="30.0" layoutY="121.0" prefHeight="70.0" prefWidth="368.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
         <children>
            <Label layoutX="15.0" layoutY="10.0" text="Select Customer (Name/Contact)" textFill="#7f8c8d" />
            <ComboBox fx:id="cmbCustomerId" editable="true" layoutX="15.0" layoutY="30.0" onAction="#cmbCustomerOnAction" onKeyReleased="#cmbCustomerOnKeyReleased" prefHeight="30.0" prefWidth="201.0" promptText="Type to Search..." />
            <Button layoutX="225.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnNewCustomerOnAction" prefHeight="30.0" prefWidth="130.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ New Customer" />
          </children>
      </AnchorPane>
      
      <!-- Product Section -->
      <AnchorPane layoutX="30.0" layoutY="204.0" prefHeight="163.0" prefWidth="368.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
         <children>
            <Label layoutX="15.0" layoutY="10.0" text="Select Product (Name)" textFill="#7f8c8d" />
            <ComboBox fx:id="cmbProductId" editable="true" layoutX="15.0" layoutY="30.0" onAction="#cmbProductOnAction" onKeyReleased="#cmbProductOnKeyReleased" prefHeight="30.0" prefWidth="201.0" promptText="Type to Search..." />
            
            <Button layoutX="226.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnNewProductOnAction" prefHeight="30.0" prefWidth="130.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ New Product" />
            
            <Label layoutX="15.0" layoutY="65.0" text="Unit Price" textFill="#7f8c8d" />
            <Label fx:id="lblUnitPrice" layoutX="15.0" layoutY="77.0" text="0.00" textFill="#00a118">
               <font>
                  <Font name="System Bold" size="19.0" />
               </font>
            </Label>
            
            <Label layoutX="149.0" layoutY="65.0" text="Qty On Hand (Kg)" textFill="#7f8c8d" />
            <Label fx:id="lblQtyOnHand" layoutX="149.0" layoutY="77.0" text="0Kg" textFill="#00a118">
               <font>
                  <Font name="System Bold" size="19.0" />
               </font>
            </Label>
            
            <Label layoutX="269.0" layoutY="64.0" text="Order Qty Kg" textFill="#7f8c8d" />
            <TextField fx:id="txtQty" layoutX="253.0" layoutY="80.0" prefHeight="25.0" prefWidth="99.0" />
            
            <Button layoutX="14.0" layoutY="117.0" mnemonicParsing="false" onAction="#btnAddToCartOnAction" prefHeight="30.0" prefWidth="344.0" style="-fx-background-color: #3a4b6b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Add to Cart" textFill="WHITE" />
         </children>
      </AnchorPane>
      
      <TableView fx:id="tblOrderCart" layoutX="407.0" layoutY="38.0" prefHeight="393.0" prefWidth="376.0">
        <columns>
          <TableColumn fx:id="colDescription" prefWidth="101.3333740234375" text="Product Name" />
          <TableColumn fx:id="colQty" prefWidth="54.666595458984375" text="Qty(Kg)" />
          <TableColumn fx:id="colUnitPrice" prefWidth="64.66668701171875" text="Unit Price" />
          <TableColumn fx:id="colTotal" prefWidth="77.33331298828125" text="Total" />
          <TableColumn fx:id="colAction" maxWidth="100.0" prefWidth="75.33331298828125" text="Action" />
        </columns>
      </TableView>
      
      <Button layoutX="405.0" layoutY="440.0" mnemonicParsing="false" onAction="#btnUpdateOrderOnAction" prefHeight="40.0" prefWidth="376.0" style="-fx-background-color: #00a118; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 5;" text="UPDATE ORDER" textFill="#1b1b1b" />
<AnchorPane layoutX="170.0" layoutY="65.0" prefHeight="45.0" prefWidth="227.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
          <children>
             <Label layoutX="14.0" layoutY="14.0" text="Tax :" textFill="#7f8c8d" />
             <Button fx:id="btnUpdate" layoutX="133.0" layoutY="10.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="25.0" prefWidth="77.0" style="-fx-background-color: #b1b1b1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Update" />
             <TextField fx:id="txtTax" editable="false" layoutX="48.0" layoutY="10.0" prefHeight="25.0" prefWidth="77.0" />
          </children>
       </AnchorPane>
      <AnchorPane layoutX="30.0" layoutY="377.0" prefHeight="103.0" prefWidth="368.0" style="-fx-background-color: #efefef; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
         <children>
            
            <Label layoutX="14.0" layoutY="13.0" text="NET TOTAL (LKR):" textFill="#c0392b">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label fx:id="lblNetTotal" layoutX="187.0" layoutY="13.0" text="0.00/=" textFill="#c0392b">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label layoutX="14.0" layoutY="46.0" text="Amount : " textFill="#7f8c8d" />
            <Label layoutX="208.0" layoutY="47.0" text="Discount (%) :" textFill="#7f8c8d" />
            <TextField fx:id="txtAmount" layoutX="69.0" layoutY="43.0" onKeyReleased="#txtAmountOnKeyReleased" prefHeight="25.0" prefWidth="130.0" />
            <TextField fx:id="txtDiscount" layoutX="284.0" layoutY="43.0" onAction="#txtDiscountOnAction" onKeyReleased="#txtDiscountOnKeyReleased" prefHeight="25.0" prefWidth="63.0" promptText="0" />
            <Label layoutX="14.0" layoutY="69.0" text="Balance : " textFill="#00a118">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Label fx:id="lblBalance" layoutX="85.0" layoutY="69.0" text="0.00/" textFill="#00a118">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
