<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="587.0" prefWidth="960.0" style="-fx-background-color: white;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.DueManagementController">
   <children>
      <!-- Title -->
      <Label layoutX="25.0" layoutY="26.0" text="Due Payment Management" textFill="#1e293b">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>

      <!-- Summary Cards -->
      <!-- Total Outstanding -->
      <AnchorPane layoutX="25.0" layoutY="69.0" prefHeight="65.0" prefWidth="230.0" style="-fx-background-color: #fef2f2; -fx-background-radius: 12; -fx-border-color: #fecaca; -fx-border-radius: 12;">
         <children>
            <Label layoutX="15.0" layoutY="8.0" text="Total Outstanding" textFill="#991b1b">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblTotalOutstanding" layoutX="15.0" layoutY="26.0" prefHeight="30.0" prefWidth="200.0" text="Rs. 0.00" textFill="#dc2626">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

            <!-- Customers with Dues -->
      <AnchorPane layoutX="270.0" layoutY="69.0" prefHeight="65.0" prefWidth="230.0" style="-fx-background-color: #fff7ed; -fx-background-radius: 12; -fx-border-color: #fed7aa; -fx-border-radius: 12;">
         <children>
            <Label layoutX="15.0" layoutY="8.0" text="Customers with Dues" textFill="#9a3412">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblCustomersWithDues" layoutX="15.0" layoutY="26.0" prefHeight="30.0" prefWidth="200.0" text="0" textFill="#ea580c">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <!-- Total Customers -->
      <AnchorPane layoutX="515.0" layoutY="69.0" prefHeight="66.0" prefWidth="216.0" style="-fx-background-color: #f0fdf4; -fx-background-radius: 12; -fx-border-color: #bbf7d0; -fx-border-radius: 12;">
         <children>
            <Label layoutX="12.0" layoutY="8.0" text="Total Customers" textFill="#166534">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblTotalCustomers" layoutX="12.0" layoutY="26.0" prefHeight="35.0" prefWidth="190.0" text="0" textFill="#16a34a">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <!-- Actions Toolbar -->
      <AnchorPane layoutX="25.0" layoutY="142.0" prefHeight="40.0" prefWidth="911.0">
         <children>
            <TextField fx:id="txtSearch" layoutX="0.0" layoutY="5.0" prefHeight="30.0" prefWidth="911.0" promptText="Search by ID, name or contact..." style="-fx-background-radius: 6; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />
         </children>
      </AnchorPane>

      <!-- Customer Table -->
      <TableView fx:id="tblCustomers" layoutX="25.0" layoutY="192.0" prefHeight="366.0" prefWidth="911.0" style="-fx-background-radius: 6;">
         <columns>
            <TableColumn fx:id="colId" prefWidth="113.0" text="Customer ID" />
            <TableColumn fx:id="colName" prefWidth="239.0" text="Name" />
            <TableColumn fx:id="colContact" prefWidth="225.0" text="Contact" />
            <TableColumn fx:id="colDue" prefWidth="196.0" text="Due Amount" />
            <TableColumn fx:id="colAction" prefWidth="137.0" text="Action" />
         </columns>
      </TableView>
      <Button layoutX="746.0" layoutY="69.0" mnemonicParsing="false" onAction="#btnReconcileOnAction" prefHeight="30.0" prefWidth="190.0" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Re-Calculate Dues" />
      <Button layoutX="746.0" layoutY="102.0" mnemonicParsing="false" onAction="#btnExportDueReportOnAction" prefHeight="30.0" prefWidth="190.0" style="-fx-background-color: #0891b2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Export Report" />
   </children>
</AnchorPane>
