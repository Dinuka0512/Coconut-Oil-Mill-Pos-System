<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="720.0" style="-fx-background-color: white;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.UserLogsController">
   <children>
      <Label layoutX="24.0" layoutY="18.0" text="User Logs" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Button layoutX="620.0" layoutY="18.0" mnemonicParsing="false" onAction="#btnRefreshOnAction" prefHeight="30.0" prefWidth="76.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Refresh" />
      <TableView fx:id="tblLogs" layoutX="24.0" layoutY="62.0" prefHeight="374.0" prefWidth="672.0">
         <columns>
            <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
            <TableColumn fx:id="colTime" prefWidth="120.0" text="Time" />
            <TableColumn fx:id="colUserName" prefWidth="170.0" text="User Name" />
            <TableColumn fx:id="colRole" prefWidth="120.0" text="Role" />
            <TableColumn fx:id="colAction" prefWidth="140.0" text="Action" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
