            </Label>

            <Label layoutX="214.0" layoutY="8.0" text="Existing Due" textFill="#64748b" />
            <Label fx:id="lblExistingDue" layoutX="214.0" layoutY="26.0" prefHeight="19.0" prefWidth="140.0" text="Rs. 0.00" textFill="#ef4444">
