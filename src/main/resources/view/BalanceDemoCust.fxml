<AnchorPane prefHeight="682.0" prefWidth="640.0" style="-fx-background-color: white; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.BalanceController">
   <children>
      <!-- Title -->
      <Label layoutX="20.0" layoutY="12.0" text="Payment / Balance" textFill="#1e293b">
