      </AnchorPane>

      <!-- Buttons -->
      <Button fx:id="btnCancel" layoutX="20.0" layoutY="617.0" mnemonicParsing="false" onAction="#btnCancelOnAction" prefHeight="36.0" prefWidth="290.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Cancel" />
      <Button fx:id="btnCompleteSale" layoutX="330.0" layoutY="617.0" mnemonicParsing="false" onAction="#btnConfirmOnAction" prefHeight="36.0" prefWidth="290.0" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Complete Sale" />
