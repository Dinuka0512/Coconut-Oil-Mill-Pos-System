<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="446.0" prefWidth="485.0" style="-fx-background-color: white; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.BalanceDemoCustController">
   <children>
      <!-- Title -->
      <Label layoutX="25.0" layoutY="20.0" text="Payment / Balance" textFill="#1e293b">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Separator layoutX="25.0" layoutY="54.0" prefHeight="3.0" prefWidth="432.0" />

      <!-- Order Items -->
      <Label layoutX="25.0" layoutY="63.0" text="Order Items" textFill="#64748b" />
      <TextArea fx:id="txtDescription" editable="false" layoutX="25.0" layoutY="82.0" prefHeight="100.0" prefWidth="432.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 10;" wrapText="true" />

      <!-- Billing Card -->
      <AnchorPane layoutX="25.0" layoutY="195.0" prefHeight="178.0" prefWidth="432.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
         <children>
            <!-- Customer -->
            <Label layoutX="15.0" layoutY="12.0" text="Customer" textFill="#64748b" />
            <Label fx:id="lblCustomer" layoutX="16.0" layoutY="30.0" prefHeight="19.0" prefWidth="224.0" text="Sample User Name" textFill="#1e293b">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>

            <!-- Existing Due -->
            <Label layoutX="350.0" layoutY="12.0" text="Existing Due" textFill="#64748b" />
            <Label fx:id="lblExistingDue" alignment="CENTER_RIGHT" layoutX="237.0" layoutY="30.0" prefHeight="19.0" prefWidth="179.0" text="Rs. 0.00" textFill="#ef4444">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>

            <Separator layoutX="15.0" layoutY="63.0" prefHeight="3.0" prefWidth="405.0" />
            <Label layoutX="161.0" layoutY="79.0" text="Bill Total : " textFill="#64748b" />
            <Label layoutX="368.0" layoutY="79.0" text="Precent :" textFill="#64748b" />
            <Label fx:id="lblBillTotal" layoutX="219.0" layoutY="80.0" prefHeight="18.0" prefWidth="102.0" text="10" textFill="#64748b" />
            <Label fx:id="lblPrecent" alignment="CENTER_RIGHT" layoutX="335.0" layoutY="97.0" prefHeight="18.0" prefWidth="78.0" text="0.02" textFill="#64748b" />
            <Label layoutX="163.0" layoutY="108.0" text="Net Total : " textFill="#64748b" />
            <Label fx:id="lblBalance1" layoutX="160.0" layoutY="119.0" prefHeight="35.0" prefWidth="190.0" text="LKR 10.02" textFill="#16a34a">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <!-- Buttons -->
      <Button layoutX="248.0" layoutY="386.0" mnemonicParsing="false" onAction="#btnConfirmOnAction" prefHeight="36.0" prefWidth="210.0" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Complete Sale" />
      <Button layoutX="27.0" layoutY="386.0" mnemonicParsing="false" onAction="#btnCancelOnAction" prefHeight="36.0" prefWidth="210.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Cancel" />
      <AnchorPane layoutX="35.0" layoutY="267.0" prefHeight="82.0" prefWidth="127.0" style="-fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
         <children>
            <Label layoutX="15.0" layoutY="17.0" text="Tax :" textFill="#64748b" />
            <CheckBox fx:id="chkPayDue1" layoutX="200.0" layoutY="50.0" managed="false" text="Pay Due" visible="false" />
            <TextField fx:id="txtTax" layoutX="46.0" layoutY="12.0" onKeyReleased="#onTaxChanged" prefHeight="26.0" prefWidth="66.0" />
            <Button fx:id="btnSaveTax" layoutX="12.0" layoutY="44.0" disable="true" mnemonicParsing="false" onAction="#btnUpdateAction" prefHeight="26.0" prefWidth="102.0" style="-fx-background-color: #393E46; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Update" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
