      </Label>
      <Separator layoutX="20.0" layoutY="44.0" prefHeight="3.0" prefWidth="600.0" />

      <!-- Order Items -->
      <Label layoutX="20.0" layoutY="52.0" text="Order Items" textFill="#64748b" />
      <TextArea fx:id="txtDescription" editable="false" layoutX="20.0" layoutY="70.0" prefHeight="101.0" prefWidth="600.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 10;" wrapText="true" />

      <!-- Billing Card -->
      <AnchorPane layoutX="20.0" layoutY="180.0" prefHeight="115.0" prefWidth="600.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
         <children>
            <Label layoutX="15.0" layoutY="8.0" text="Customer" textFill="#64748b" />
