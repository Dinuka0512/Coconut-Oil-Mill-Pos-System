               </font>
            </Label>

            <AnchorPane layoutX="385.0" layoutY="11.0" prefHeight="74.0" prefWidth="200.0" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
               <children>
                  <Label layoutX="25.0" layoutY="12.0" text="Tax :" textFill="#64748b" />
                  <TextField fx:id="txtTax" layoutX="62.0" layoutY="7.0" onKeyReleased="#onTaxChanged" prefHeight="25.0" prefWidth="119.0" />
