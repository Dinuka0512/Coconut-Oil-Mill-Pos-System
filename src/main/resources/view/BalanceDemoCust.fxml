            <TextField fx:id="txtAmountPaid1" layoutX="14.0" layoutY="33.0" onAction="#onAmountPaidAction" onKeyReleased="#onAmountPaidChanged" prefHeight="28.0" prefWidth="157.0" promptText="0.00" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            <Label layoutX="182.0" layoutY="13.0" text="Payment Method" textFill="#64748b" />
            <ComboBox fx:id="cmbPaymentMethod1" layoutX="182.0" layoutY="32.0" onAction="#onPaymentMethodAction" prefHeight="28.0" prefWidth="127.0" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            <Label layoutX="317.0" layoutY="14.0" text="Bank Account (Card) " textFill="#64748b" />
            <ComboBox fx:id="cmbBankAccount" layoutX="317.0" layoutY="32.0" prefHeight="28.0" prefWidth="138.0" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            <Label layoutX="462.0" layoutY="14.0" text="Check ID (Cheque) " textFill="#64748b" />
            <TextField fx:id="txtCheckId" layoutX="462.0" layoutY="32.0" onAction="#onCheckIdAction" prefHeight="28.0" prefWidth="119.0" promptText="Check No" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            <Button fx:id="btnAddPayment" layoutX="15.0" layoutY="132.0" mnemonicParsing="false" onAction="#btnAddPaymentOnAction" prefHeight="28.0" prefWidth="570.0" style="-fx-background-color: #13434a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="+ Add Payment" />
            <Label layoutX="15.0" layoutY="74.0" text="Customer Name" textFill="#64748b" />
            <TextField fx:id="txtCheckId1" layoutX="15.0" layoutY="92.0" onAction="#onCheckIdAction" prefHeight="28.0" prefWidth="283.0" promptText="Name" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            <Label layoutX="304.0" layoutY="73.0" text="Customer Contact" textFill="#64748b" />
            <TextField fx:id="txtCheckId11" layoutX="303.0" layoutY="91.0" onAction="#onCheckIdAction" prefHeight="28.0" prefWidth="283.0" promptText="Contact" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
         </children>
      </AnchorPane>

                        <TableView fx:id="tblPayments" layoutX="20.0" layoutY="489.0" prefHeight="115.0" prefWidth="410.0" style="-fx-background-radius: 5;">
        <columns>
            <TableColumn fx:id="colPayMethod" prefWidth="68.00006103515625" text="Method" />
            <TableColumn fx:id="colPayAmount" prefWidth="105.60003662109375" text="Amount (Rs.)" />
            <TableColumn fx:id="colPayDetail" prefWidth="178.39996337890625" text="Bank Account / Check ID" />
            <TableColumn fx:id="colPayAction" prefWidth="56.0" text="" />
        </columns>
      </TableView>
      <Label layoutX="565.0" layoutY="557.0" text="Balance :" textFill="#64748b" />
      <Label fx:id="lblBalance" alignment="CENTER_RIGHT" layoutX="383.0" layoutY="568.0" prefHeight="35.0" prefWidth="229.0" text="LKR 1111110.00/=" textFill="#16a34a">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label alignment="CENTER_RIGHT" layoutX="512.0" layoutY="513.0" text="Total Paid Amount : " textFill="#64748b" />
      <Label fx:id="lblPaymentTableTotal" alignment="CENTER_RIGHT" layoutX="438.0" layoutY="528.0" prefHeight="17.0" prefWidth="179.0" text="LKR 1000.00/=" textFill="#64748b">
         <font>
            <Font name="System Bold" size="15.0" />
         </font></Label>
      <!-- Hidden due-payment controls required by BalanceController -->
      <ComboBox fx:id="duePayType" layoutX="0.0" layoutY="0.0" managed="false" prefWidth="0.0" visible="false" />
      <TextField fx:id="txtPayDueAmount" layoutX="0.0" layoutY="0.0" managed="false" prefWidth="0.0" visible="false" />
