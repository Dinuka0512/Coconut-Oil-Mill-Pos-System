<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="587.0" prefWidth="960.0" style="-fx-background-color: white;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.OrderManageController">
   <children>
       <Label layoutX="32.0" layoutY="29.0" text="Invoice Management" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <AnchorPane layoutX="35.0" layoutY="80.0" prefHeight="100.0" prefWidth="891.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
         <children>
             <Label layoutX="25.0" layoutY="26.0" text="Search Invoice : " textFill="#7f8c8d" />
             <TextField fx:id="txtSearch" layoutX="25.0" layoutY="43.0" onKeyReleased="#txtSearchOnKeyReleased" prefHeight="30.0" prefWidth="308.0" promptText="Search by Invoice ID or Total" style="-fx-background-radius: 5;" />
            
             <Button fx:id="btnSearch" layoutX="348.0" layoutY="42.0" mnemonicParsing="false" onAction="#btnSearchOnAction" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Search" />
              <Button fx:id="btnViewBill" layoutX="433.0" layoutY="42.0" mnemonicParsing="false" onAction="#btnViewBillOnAction" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="View Bill" />
              <Button fx:id="btnDelete" layoutX="518.0" layoutY="42.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Delete" />
            
            <Label layoutX="805.0" layoutY="23.0" text="Select Date" textFill="#7f8c8d" />
            <DatePicker fx:id="datePicker" layoutX="663.0" layoutY="42.0" prefHeight="30.0" prefWidth="201.0" />
         </children>
      </AnchorPane>
      
      <TableView fx:id="tblOrders" layoutX="35.0" layoutY="193.0" prefHeight="356.0" prefWidth="891.0" style="-fx-background-radius: 10;">
         <columns>
             <TableColumn fx:id="colOrderId" prefWidth="80.0" text="Invoice ID" />
            <TableColumn fx:id="colDate" prefWidth="68.0" text="Date" />
            <TableColumn fx:id="colCustomer" prefWidth="127.99998474121094" text="Customer" />
            <TableColumn fx:id="colContact" prefWidth="114.4000244140625" text="Contact" />
            <TableColumn fx:id="colTotal" prefWidth="111.20001220703125" text="Total (LKR)" />
            <TableColumn fx:id="colAction" prefWidth="88.00006103515625" text="Action" />
            <TableColumn fx:id="colCreated" prefWidth="144.79998779296875" text="Created (By / At)" />
            <TableColumn fx:id="colUpdated" prefWidth="160.00006103515625" text="Updated (By / At)" />
         </columns>
      </TableView>
      <TableView fx:id="tblTdySales" layoutX="33.0" layoutY="194.0" prefHeight="312.0" prefWidth="891.0" style="-fx-background-radius: 10;" visible="false">
         <columns>
            <TableColumn fx:id="colProductId" prefWidth="139.20000839233398" text="Product ID" />
            <TableColumn fx:id="colProductName" prefWidth="399.99998474121094" text="Product Name" />
            <TableColumn fx:id="colSoldQty" minWidth="3.2000732421875" prefWidth="112.0" text="Sell qty" />
            <TableColumn fx:id="colSoldTotal" prefWidth="239.2000732421875" text="Total (LKR)" />
         </columns>
      </TableView>
<Button fx:id="btnViewOption" layoutX="572.0" layoutY="32.0" mnemonicParsing="false" onAction="#btnViewOptionOnAction" prefHeight="30.0" prefWidth="354.0" text="View Summary" />
      <AnchorPane fx:id="tdySummary" layoutX="35.0" layoutY="512.0" prefHeight="43.0" prefWidth="891.0" visible="false">
         <children>
            <Label fx:id="lblSummaryTotal" alignment="CENTER_RIGHT" contentDisplay="RIGHT" layoutX="406.0" layoutY="2.0" nodeOrientation="LEFT_TO_RIGHT" prefHeight="35.0" prefWidth="484.0" text="Total : 1000/=" textAlignment="RIGHT" textFill="RED">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label fx:id="lblSummarySoldCount" alignment="CENTER_RIGHT" layoutX="2.0" layoutY="7.0" text="Sold product count : 10">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
      <Button fx:id="btnSummaryReport" layoutX="375.0" layoutY="32.0" mnemonicParsing="false" onAction="#btnGenerateSelectedDateSummary" prefHeight="30.0" prefWidth="186.0" style="-fx-background-color: #ffc000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Generate Summary Report" visible="false" />
      </children>
</AnchorPane>
