<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="587.0" prefWidth="960.0" style="-fx-background-color: white;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev09.kumaracoconutoil.controller.SupplierController">
   <children>
      <Label layoutX="32.0" layoutY="21.0" text="Supplier Management" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>

      <AnchorPane fx:id="formPane" layoutX="32.0" layoutY="74.0" prefHeight="135.0" prefWidth="878.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
         <children>
            <Label layoutX="20.0" layoutY="15.0" text="Name" textFill="#7f8c8d" />
            <TextField fx:id="txtName" layoutX="20.0" layoutY="35.0" onAction="#onNameAction" prefHeight="30.0" prefWidth="412.0" promptText="Enter Name" style="-fx-background-radius: 5;" />

            <Label layoutX="451.0" layoutY="15.0" text="Contact Number" textFill="#7f8c8d" />
            <TextField fx:id="txtContact" layoutX="451.0" layoutY="35.0" onAction="#onContactAction" prefHeight="30.0" prefWidth="396.0" promptText="07XXXXXXXX" style="-fx-background-radius: 5;" />

            <Button fx:id="btnSave" layoutX="774.0" layoutY="83.0" mnemonicParsing="false" onAction="#btnSaveOnAction" prefHeight="35.0" prefWidth="70.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Save" />
            <Button fx:id="btnUpdate" layoutX="694.0" layoutY="83.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="35.0" prefWidth="70.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Update" />
            <Button fx:id="btnDelete" layoutX="614.0" layoutY="83.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="35.0" prefWidth="70.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Delete" />
            <Button fx:id="btnClear" layoutX="534.0" layoutY="83.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="35.0" prefWidth="70.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Clear" />
            <Button layoutX="22.0" layoutY="83.0" mnemonicParsing="false" onAction="#exportSupplier" prefHeight="35.0" prefWidth="227.0" style="-fx-background-color: #ffc000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Generate PDF" />
         </children>
      </AnchorPane>

      <TextField fx:id="txtSearch" layoutX="32.0" layoutY="225.0" onKeyReleased="#txtSearchOnKeyReleased" prefHeight="35.0" prefWidth="878.0" promptText="Search Supplier by ID, Name or Contact..." style="-fx-background-radius: 20; -fx-padding: 0 15 0 15; -fx-border-color: #bdc3c7; -fx-border-radius: 20;" />

      <TableView fx:id="tblSupplier" layoutX="32.0" layoutY="275.0" prefHeight="284.0" prefWidth="438.0" style="-fx-background-radius: 5;">
        <columns>
            <TableColumn fx:id="colName" prefWidth="124.0" text="Name" />
            <TableColumn fx:id="colContact" prefWidth="87.0" text="Contact" />
            <TableColumn fx:id="colCreated" prefWidth="112.0" text="Created (By / At)" />
            <TableColumn fx:id="colUpdated" prefWidth="113.0" text="Updated (By / At)" />
        </columns>
      </TableView>
      <TableView fx:id="tblSuppliersProduct" layoutX="480.0" layoutY="275.0" prefHeight="241.0" prefWidth="438.0" style="-fx-background-radius: 5;">
         <columns>
            <TableColumn fx:id="colProdItemCode" prefWidth="67.0" text="Item Code" />
            <TableColumn fx:id="colProdName" prefWidth="137.0" text="Name" />
            <TableColumn fx:id="colProdPrice" prefWidth="92.0" text="Prices (LKR)" />
            <TableColumn fx:id="colProdQty" prefWidth="83.0" text="Qty (Kg)" />
            <TableColumn fx:id="colProdQty1" prefWidth="58.0" text="Action" />
         </columns>
      </TableView>
      <Button fx:id="btnAddProduct" disable="true" layoutX="480.0" layoutY="524.0" mnemonicParsing="false" onAction="#btnAddProductOnAction" prefHeight="35.0" prefWidth="438.0" style="-fx-background-color: #008a65; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ Add Product" />
   </children>
</AnchorPane>
